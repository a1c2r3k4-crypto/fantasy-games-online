PORT=3000
# Deja CLIENT_ORIGINS vacío mientras abras el HTML descargado desde tu equipo.
# Al publicar el sitio del juego, coloca aquí el origen exacto, por ejemplo https://tu-juego.pages.dev
CLIENT_ORIGINS=

# Genera este hash en tu equipo con: npm run hash-password
DEDICATION_PASSWORD_HASH=
# Define estos textos en Render > Environment, no los agregues al HTML público.
DEDICATION_TITLE=
DEDICATION_SIGNATURE=
DEDICATION_MESSAGE=
